@{
    ViewData["Title"] = "Acesso Negado - HDG Rebaixados";
}

@section Head {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="hdg-logo-link d-inline-block">
            <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 96px; width: auto; filter: drop-shadow(0 6px 18px var(--accent-green-glow));" loading="eager" asp-append-version="true" />
        </a>
    </div>
    <div class="glass-panel p-5 max-w-600 mx-auto border border-danger border-opacity-50 shadow-lg">
        <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.4);">
            <i class="bi bi-shield-x display-3 text-danger"></i>
        </div>
        <h2 class="text-white fw-bold font-heading text-uppercase">Acesso Não Permitido</h2>
        <p class="text-secondary mb-4">Você não tem permissão para acessar esta página.</p>
        <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark-custom">
                <i class="bi bi-house-door me-1"></i> Voltar ao Início
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-racing">
                        <i class="bi bi-box-arrow-right me-1"></i> Trocar de Conta
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="btn btn-racing">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login
                </a>
            }
        </div>
    </div>
</div>
