@model HDG.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Entrar na Garagem";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="glass-panel overflow-hidden border border-secondary border-opacity-25 shadow-lg">
                <div class="row g-0">
                    <!-- Coluna Visual / Marca Stance (Desktop) -->
                    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between p-5 position-relative carbon-pattern" style="border-right: 1px solid var(--border-subtle);">
                        <div class="watermark-stance" style="top: 25%; font-size: 8rem;">HDG</div>
                        <div class="position-relative z-1">
                            <a asp-controller="Home" asp-action="Index" class="hdg-logo-link mb-4 d-inline-block">
                                <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 96px; width: auto; filter: drop-shadow(0 6px 18px var(--accent-green-glow));" loading="eager" asp-append-version="true" />
                            </a>
                            <div class="hero-seal mb-3">ACESSO EXCLUSIVO</div>
                            <h2 class="display-6 fw-bold text-white font-heading">
                                A Cultura do Carro Baixo na Palma da Mão.
                            </h2>
                            <p class="text-secondary small mt-3" style="line-height: 1.8;">
                                Acesse para acompanhar seus pedidos, favoritar peças, interagir na comunidade e avaliar produtos instalados no seu carro.
                            </p>
                        </div>

                        <div class="position-relative z-1 pt-4 border-top border-secondary border-opacity-25 d-flex gap-3 text-secondary small">
                            <div><i class="bi bi-shield-lock text-success me-1"></i> Ambiente Seguro</div>
                            <div><i class="bi bi-speedometer text-warning me-1"></i> Acesso Ágil</div>
                        </div>
                    </div>

                    <!-- Coluna Formulário de Login -->
                    <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center">
                        <div class="d-lg-none text-center mb-4">
                            <a asp-controller="Home" asp-action="Index" class="hdg-logo-link d-inline-block">
                                <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 96px; width: auto; filter: drop-shadow(0 6px 18px var(--accent-green-glow));" loading="eager" asp-append-version="true" />
                            </a>
                        </div>
                        <div class="mb-4">
                            <span class="badge mb-2 px-3 py-1 font-display" style="background: var(--accent-green-glow-subtle); color: var(--accent-green); border: 1px solid var(--accent-green); letter-spacing: 0.08em;">BEM-VINDO DE VOLTA</span>
                            <h3 class="text-white fw-bold font-heading">Acesse Sua Conta</h3>
                            <p class="text-secondary small mb-0">Insira suas credenciais para entrar no painel HDG.</p>
                        </div>

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                        {
                            <div class="alert alert-danger bg-danger bg-opacity-25 border border-danger text-white small" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <!-- Credenciais de Demonstração Rápidas -->
                        <div class="p-3 rounded-3 mb-4 border border-secondary border-opacity-25" style="background: var(--accent-green-glow-subtle); border-color: var(--border-accent) !important;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="small" style="color: var(--accent-green);"><i class="bi bi-shield-check"></i> Credenciais Demo:</strong>
                                <button type="button" class="btn btn-sm btn-racing py-0 px-2 fw-bold" onclick="preencherAdmin()" style="font-size: 0.75rem; height: 26px;">
                                    Auto-preencher
                                </button>
                            </div>
                            <div class="text-secondary" style="font-size: 0.8rem;">
                                <div>E-mail: <code class="text-white">admin@hdgrebaixados.com.br</code></div>
                                <div>Senha: <code class="text-white">Admin@HDG2026!</code></div>
                            </div>
                        </div>

                        <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label-custom">E-mail</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" id="inputEmail" class="form-control form-control-custom" placeholder="seu@email.com" required autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">Senha</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary">
                                        <i class="bi bi-key"></i>
                                    </span>
                                    <input asp-for="Senha" id="inputSenha" type="password" class="form-control form-control-custom" placeholder="••••••••" required />
                                </div>
                                <span asp-validation-for="Senha" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-racing w-100 justify-content-center mb-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar na Plataforma
                            </button>

                            <div class="text-center text-secondary small">
                                Não possui conta? <a asp-action="Registro" class="fw-bold text-decoration-none" style="color: var(--accent-green);">Cadastre-se grátis</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function preencherAdmin() {
            document.getElementById('inputEmail').value = 'admin@hdgrebaixados.com.br';
            document.getElementById('inputSenha').value = 'Admin@HDG2026!';
        }
    </script>
}