@{
    ViewData["Title"] = "Sobre a HDG Rebaixados";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge px-3 py-2 text-uppercase fw-bold" style="background: rgba(0, 230, 118, 0.15); color: var(--accent-green); border: 1px solid var(--accent-green);">Nossa História</span>
        <h1 class="display-5 fw-bold text-white mt-2 font-heading">Paixão por Altura Baixa & Alta Performance</h1>
        <p class="text-secondary max-w-600 mx-auto fs-5">A HDG Rebaixados nasceu da cultura eurolook, stance e street custom com a missão de entregar suspensões e rodas de qualidade suprema.</p>
    </div>

    <div class="row g-4 align-items-center mb-5">
        <div class="col-lg-6">
            <div class="glass-panel p-4 p-md-5">
                <h3 class="text-white fw-bold mb-3 font-heading">
                    <i class="bi bi-gear-fill text-success me-2"></i> Nossa Oficina & Garagem
                </h3>
                <p class="text-secondary" style="line-height: 1.8;">
                    Fundada por entusiastas do automobilismo e preparação automotiva, a <strong>HDG Rebaixados</strong> é hoje uma das marcas mais respeitadas no cenário nacional de customização de suspensão.
                </p>
                <p class="text-secondary" style="line-height: 1.8;">
                    Trabalhamos lado a lado com os melhores fabricantes de cilindros de alumínio, blocos de válvulas rápidos de 8mm e 10mm, bolsas gomadas cônicas e rodas esportivas tala larga (BBS, Rotiform, Enkei styles).
                </p>
                <div class="d-flex gap-3 mt-4">
                    <div class="border-start border-success border-3 ps-3">
                        <h4 class="text-white fw-bold mb-0">+5.000</h4>
                        <small class="text-secondary">Clientes Satisfeitos</small>
                    </div>
                    <div class="border-start border-warning border-3 ps-3">
                        <h4 class="text-white fw-bold mb-0">100%</h4>
                        <small class="text-secondary">Peças com Procedência</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="rounded-4 overflow-hidden shadow-lg border border-secondary border-opacity-25">
                <img src="~/img/placeholder-peca.png" 
                     alt="Oficina HDG Rebaixados" class="img-fluid w-100" style="max-height: 420px; object-fit: cover;" />
            </div>
        </div>
    </div>

    <!-- Contact Banner -->
    <div class="glass-panel p-5 text-center position-relative overflow-hidden">
        <div class="position-relative">
            <h2 class="text-white fw-bold mb-3 font-heading">Tem Dúvidas Sobre Qual Suspensão Serve no Seu Carro?</h2>
            <p class="text-secondary max-w-600 mx-auto mb-4">Envie o ano, modelo e aro das rodas do seu carro diretamente no WhatsApp para nossos preparadores indicarem o setup perfeito.</p>
            <a href="https://wa.me/5511999999999?text=@Uri.EscapeDataString("Olá! Gostaria de consultar compatibilidade de peças para o meu carro com a equipe da HDG Rebaixados.")" target="_blank" class="btn btn-whatsapp btn-lg">
                <i class="bi bi-whatsapp me-2"></i> Iniciar Atendimento via WhatsApp
            </a>
        </div>
    </div>
</div>