<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HDG Rebaixados | Stance, Suspensões & Peças Automotivas</title>
    <meta name="description" content="Kits completos de suspensão a ar, fixa e rosca, rodas tala larga e freios esportivos na HDG Rebaixados. Projetos exclusivos para carros baixos com envio Brasil." />

    <!-- Favicon & Icons -->
    <!-- Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/hdg-favicon-16x16.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/hdg-favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/hdg-favicon-192x192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/hdg-apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#060809" />

    <!-- Open Graph & Twitter Cards -->
    @{
        var ogImageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/img/hdg-og-image.png")}";
    }
    <meta property="og:title" content="@ViewData["Title"] - HDG Rebaixados" />
    <meta property="og:description" content="Kits completos de suspensão a ar, fixa e rosca, rodas tala larga e freios esportivos na HDG Rebaixados. Projetos exclusivos para carros baixos." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - HDG Rebaixados" />
    <meta name="twitter:description" content="Kits completos de suspensão a ar, fixa e rosca, rodas tala larga e freios esportivos na HDG Rebaixados." />
    <meta name="twitter:image" content="@ogImageUrl" />

    <!-- Google Fonts: Bebas Neue (Display/Títulos), Outfit (Heading/Preços) & Inter (Corpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <!-- Faixa Superior de Destaque Discreta e Premium -->
    <aside class="announcement-strip" id="hdg-announcement-strip" role="region" aria-label="Avisos e Destaques">
        <div class="container d-flex justify-content-between align-items-center h-100 position-relative">
            <!-- Espaçador invisível para balancear o botão fechar e manter centralização perfeita -->
            <div class="announcement-spacer d-none d-lg-block" aria-hidden="true"></div>

            <!-- Container das Mensagens -->
            <div class="announcement-content text-center flex-grow-1" id="announcement-slider" aria-live="polite">
                <!-- Mensagem 1 -->
                <div class="announcement-item announcement-item-active" data-index="0">
                    <span class="announcement-icon"><i class="bi bi-patch-check-fill"></i></span>
                    <span class="announcement-text">
                        Especialistas em suspensão a ar, rosca e fixa, e rodas <strong class="announcement-highlight">tala larga</strong>
                    </span>
                </div>

                <!-- Separador no Desktop -->
                <span class="announcement-divider d-none d-lg-inline" aria-hidden="true">•</span>

                <!-- Mensagem 2 -->
                <div class="announcement-item" data-index="1">
                    <span class="announcement-icon"><i class="bi bi-truck"></i></span>
                    <span class="announcement-text">
                        Envio para todo o Brasil com <strong class="announcement-highlight">nota fiscal</strong> e <strong class="announcement-highlight">garantia</strong>
                    </span>
                </div>
            </div>

            <!-- Botão de Fechar Faixa -->
            <button type="button" class="announcement-close-btn" id="btn-fechar-announcement" aria-label="Fechar faixa de aviso" title="Fechar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </aside>

    <!-- Navegação Principal com Backdrop Blur Refinado -->
    <header class="glass-nav">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container">
                <!-- Marca & Logo Oficial -->
                <a class="navbar-brand hdg-logo-link" asp-area="" asp-controller="Home" asp-action="Index" title="HDG Rebaixados - Página Inicial">
                    <img src="~/img/hdg-logo-header.png" 
                         alt="HDG Rebaixados" 
                         class="hdg-logo-img" 
                         width="64" 
                         height="64" 
                         loading="eager" 
                         asp-append-version="true" />
                </a>

                <!-- Botão Menu Mobile (Hambúrguer) -->
                <button class="navbar-toggler border-0 text-white p-2" type="button" data-bs-toggle="collapse" data-bs-target="#hdgNavbar" aria-controls="hdgNavbar" aria-expanded="false" aria-label="Abrir Menu Principal">
                    <i class="bi bi-list fs-1 text-white"></i>
                </button>

                <!-- Itens de Navegação & Ações -->
                <div class="collapse navbar-collapse" id="hdgNavbar">
                    <ul class="navbar-nav me-auto mb-3 mb-lg-0 ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" data-filtro-catalogo="todos">
                                <i class="bi bi-grid-fill me-1"></i> Catálogo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="1" data-filtro-catalogo="1">
                                Suspensão
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="2" data-filtro-catalogo="2">
                                Rodas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="3" data-filtro-catalogo="3">
                                Freios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="5" data-filtro-catalogo="5">
                                Escapamento
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Sobre">
                                Sobre Nós
                            </a>
                        </li>
                    </ul>

                    <!-- Perfil & Botão Chamar no Zap -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-profile-menu dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Minha Conta">
                                    <i class="bi bi-person-circle fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary p-2 shadow-lg" aria-labelledby="userMenuDropdown" style="min-width: 200px;">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="dropdown-item d-flex align-items-center gap-2 py-2 text-warning fw-bold">
                                                <i class="bi bi-speedometer2"></i> Painel Admin
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary border-opacity-25 my-1"></li>
                                    }
                                    <li>
                                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger fw-bold">
                                                <i class="bi bi-box-arrow-right"></i> Sair da Conta
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Auth" asp-action="Login" class="nav-link nav-link-custom">
                                <i class="bi bi-person-fill me-1"></i> Entrar
                            </a>
                        }

                        <a href="https://wa.me/5511999999999?text=@Uri.EscapeDataString("Olá! Quero montar um setup para meu carro com a HDG Rebaixados.")" target="_blank" class="btn btn-whatsapp text-nowrap">
                            <i class="bi bi-whatsapp"></i> <span>Falar no Zap</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Corpo de Conteúdo Principal -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Botão Flutuante de WhatsApp com Pulso Neon -->
    <a href="https://wa.me/5511999999999?text=@Uri.EscapeDataString("Olá! Gostaria de falar com um preparador da HDG Rebaixados.")" 
       target="_blank" 
       class="whatsapp-float-btn" 
       title="Falar no WhatsApp com a Garagem HDG" 
       aria-label="Atendimento via WhatsApp">
        <i class="bi bi-whatsapp"></i>
        <span class="whatsapp-float-pulse"></span>
    </a>

    <!-- Rodapé Premium Autêntico (4 Colunas) -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 mb-5">
                <!-- Coluna 1: Marca & Filosofia -->
                <div class="col-lg-4 col-md-6">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="hdg-logo-link mb-3 d-inline-block">
                        <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 72px; width: auto;" loading="lazy" asp-append-version="true" />
                    </a>
                    <p class="text-secondary small mb-3">
                        A autoridade em suspensão especial, rodas esportivas e projetos stance de alto calibre no Brasil. O seu carro no chão com segurança, tecnologia e alinhamento milimétrico.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-dark border border-secondary text-secondary p-2">
                            <i class="bi bi-shield-check text-success me-1"></i> 100% Peças com NF
                        </span>
                        <span class="badge bg-dark border border-secondary text-secondary p-2">
                            <i class="bi bi-truck text-warning me-1"></i> Envio Brasil Todo
                        </span>
                    </div>
                </div>

                <!-- Coluna 2: Categorias Principais -->
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3 font-heading text-uppercase">Categorias</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a href="/?categoria=1" class="text-secondary text-decoration-none">Suspensão a Ar</a></li>
                        <li><a href="/?categoria=1" class="text-secondary text-decoration-none">Suspensão de Rosca</a></li>
                        <li><a href="/?categoria=1" class="text-secondary text-decoration-none">Suspensão Fixa</a></li>
                        <li><a href="/?categoria=2" class="text-secondary text-decoration-none">Rodas Tala Larga</a></li>
                        <li><a href="/?categoria=3" class="text-secondary text-decoration-none">Freios & Big Brakes</a></li>
                        <li><a href="/?categoria=5" class="text-secondary text-decoration-none">Escapamento & Ronco</a></li>
                    </ul>
                </div>

                <!-- Coluna 3: Atendimento & Garagem -->
                <div class="col-lg-3 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3 font-heading text-uppercase">Atendimento & Garagem</h6>
                    <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                        <li><i class="bi bi-geo-alt text-success me-2"></i> São Paulo - SP, Brasil</li>
                        <li><i class="bi bi-clock text-warning me-2"></i> Seg a Sex: 08h às 18h | Sáb: 08h às 13h</li>
                        <li><i class="bi bi-whatsapp text-success me-2"></i> (11) 99999-9999</li>
                        <li><i class="bi bi-envelope text-info me-2"></i> contato@hdgrebaixados.com.br</li>
                    </ul>
                </div>

                <!-- Coluna 4: Acesso Rápido -->
                <div class="col-lg-3 col-md-12">
                    <h6 class="text-white fw-bold mb-3 font-heading text-uppercase">Acesso Rápido</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="https://wa.me/5511999999999?text=@Uri.EscapeDataString("Olá! Quero cotar um kit de suspensão para o meu carro.")" target="_blank" class="btn btn-sm btn-whatsapp text-start">
                            <i class="bi bi-chat-dots-fill me-1"></i> Falar com Preparador
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-dark-custom text-start text-warning">
                                <i class="bi bi-shield-lock-fill me-1"></i> Painel do Administrador
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Faixa Inferior de Direitos -->
            <div class="pt-3 border-top border-secondary border-opacity-10 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-secondary">
                <div>
                    &copy; 2026 HDG Rebaixados. Todos os direitos reservados.
                </div>
                <div class="text-muted">
                    Cultura Stance & Street Custom • Alta Performance
                </div>
            </div>
        </div>
    </footer>

    <!-- Modal Global de Sucesso da Avaliação (Design Central Premium) -->
    @if (TempData["SucessoAvaliacao"] != null)
    {
        var primeiroNome = TempData["PrimeiroNomeAvaliacao"] as string;
        <div class="modal fade" id="modalSucessoAvaliacao" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modalSucessoTitulo" aria-hidden="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border border-secondary border-opacity-25 shadow-lg text-center p-4 p-md-5" style="background: radial-gradient(circle at 50% 0%, rgba(154, 224, 0, 0.12) 0%, rgba(12, 15, 18, 0.98) 75%); pointer-events: auto;">
                    <div class="d-flex justify-content-end w-100">
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <!-- Ícone de Check Animado -->
                    <div class="my-3 d-flex justify-content-center">
                        <div class="success-checkmark-circle">
                            <i class="bi bi-check-lg success-checkmark-icon"></i>
                        </div>
                    </div>

                    <h3 class="text-white fw-bold font-heading mb-2 mt-2" id="modalSucessoTitulo">
                        Avaliação registrada!
                    </h3>

                    <p class="text-secondary mb-4 fs-6 px-lg-3" style="line-height: 1.6;">
                        @if (!string.IsNullOrEmpty(primeiroNome))
                        {
                            <span>Obrigado, <strong class="text-white">@primeiroNome</strong>! Sua avaliação foi enviada e será publicada após a análise da nossa equipe.</span>
                        }
                        else
                        {
                            <span>@TempData["SucessoAvaliacao"]</span>
                        }
                    </p>

                    <div class="d-flex justify-content-center">
                        <button type="button" class="btn btn-racing px-5 py-2 fw-bold" id="btnFecharModalSucesso" data-bs-dismiss="modal">
                            Entendi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Seção de Modais Renderizados no Nível Raiz do Body -->
    @await RenderSectionAsync("Modais", required: false)

    <!-- Container Global de Toasts (Notificações Flutuantes no Canto Superior Direito) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
        @if (TempData["ErroAvaliacao"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-5 text-white"></i>
                        <div>@TempData["ErroAvaliacao"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-white"></i>
                        <div>@TempData["MensagemErro"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
        @if (TempData["MensagemSucesso"] != null && TempData["SucessoAvaliacao"] == null)
        {
            <div class="toast align-items-center text-white bg-dark border border-success border-opacity-50 show shadow-lg" role="alert" aria-live="polite" aria-atomic="true" data-bs-autohide="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2 text-white">
                        <i class="bi bi-check-circle-fill fs-5" style="color: var(--accent-green);"></i>
                        <div>@TempData["MensagemSucesso"]</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
                </div>
            </div>
        }
    </div>

    <!-- Bootstrap Bundle JS & Custom Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
