<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão Garagem | HDG Rebaixados</title>

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/hdg-favicon-16x16.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/hdg-favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/hdg-favicon-192x192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/hdg-apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#060809" />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts: Bebas Neue, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <!-- Topbar do Painel Administrativo -->
    <header class="admin-topbar d-flex justify-content-between align-items-center">
        <!-- Lado Esquerdo: Hambúrguer (Mobile) + Logo + Badge -->
        <div class="d-flex align-items-center gap-2 gap-md-3">
            <!-- Botão Hambúrguer para Off-Canvas no Mobile -->
            <button class="admin-toggle-sidebar-btn d-lg-none" 
                    type="button" 
                    data-bs-toggle="offcanvas" 
                    data-bs-target="#adminOffcanvasSidebar" 
                    aria-controls="adminOffcanvasSidebar" 
                    aria-label="Abrir menu">
                <i class="bi bi-list"></i>
            </button>

            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="hdg-logo-link d-flex align-items-center">
                <img src="~/img/hdg-logo-header.png" 
                     alt="HDG Rebaixados" 
                     class="admin-logo-img"
                     loading="eager"
                     asp-append-version="true" />
            </a>
            <span class="admin-badge-top">GARAGEM ADMIN</span>
        </div>

        <!-- Lado Direito: Ver Catálogo Público + Menu de Perfil -->
        <div class="d-flex align-items-center gap-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" 
               class="btn btn-outline-dark-custom admin-btn-catalog" 
               aria-label="Ver Catálogo Público"
               title="Ver Catálogo Público">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>Ver Catálogo</span>
            </a>

            <div class="dropdown">
                <button class="btn btn-profile-menu dropdown-toggle d-flex align-items-center justify-content-center" 
                        type="button" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false" 
                        aria-label="Menu de Perfil"
                        title="Menu de Perfil"
                        style="width: 40px; height: 40px;">
                    <i class="bi bi-person-fill-gear fs-5 text-warning"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow-lg p-2" style="min-width: 180px;">
                    <li>
                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger py-2 fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-box-arrow-right"></i> Encerrar Sessão
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Shell do Painel Administrativo (CSS Grid) -->
    <div class="admin-shell-grid">
        <!-- Sidebar Desktop (Fixa / Sticky no fluxo >= 992px) -->
        <aside class="admin-sidebar-desktop d-none d-lg-block" id="adminSidebarDesktop">
            <partial name="_AdminMenu" />
        </aside>

        <!-- Conteúdo Principal da Página Admin -->
        <main class="admin-main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Offcanvas Mobile (< 992px) como filho DIRETO do body (Fora do shell e sem stacking context) -->
    <div class="offcanvas offcanvas-start admin-offcanvas-mobile d-lg-none" 
         tabindex="-1" 
         id="adminOffcanvasSidebar" 
         aria-labelledby="adminOffcanvasLabel"
         aria-modal="true"
         role="dialog">
        @{
            ViewData["IsMobileMenu"] = true;
        }
        <partial name="_AdminMenu" />
    </div>

    <!-- Seção de Modais Renderizados no Nível Raiz do Body (Previne conflitos de stacking context e backdrop) -->
    @await RenderSectionAsync("Modais", required: false)

    <!-- Container Global Unificado de Notificações / Toasts (Filho direto de body, canto inferior) -->
    <div id="toast-container" aria-live="polite" aria-atomic="true">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="hdg-toast hdg-toast-sucesso" role="status" data-bs-autohide="true" data-bs-delay="5000">
                <i class="bi bi-check-circle-fill hdg-toast-icon"></i>
                <div class="hdg-toast-body">@TempData["MensagemSucesso"]</div>
                <button type="button" class="hdg-toast-close" aria-label="Fechar notificação">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div class="hdg-toast hdg-toast-erro" role="alert" data-bs-autohide="true" data-bs-delay="7000">
                <i class="bi bi-exclamation-octagon-fill hdg-toast-icon"></i>
                <div class="hdg-toast-body">@TempData["MensagemErro"]</div>
                <button type="button" class="hdg-toast-close" aria-label="Fechar notificação">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }
    </div>

    <!-- Bootstrap Bundle JS & Custom Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Gerenciamento completo do menu offcanvas no mobile do painel Admin
        document.addEventListener('DOMContentLoaded', function () {
            var offcanvasEl = document.getElementById('adminOffcanvasSidebar');
            if (offcanvasEl && typeof bootstrap !== 'undefined') {
                var bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);

                // Fechar ao clicar em qualquer link de navegação dentro do offcanvas
                var navLinks = offcanvasEl.querySelectorAll('.admin-nav-item, .offcanvas-body a');
                navLinks.forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.innerWidth < 992) {
                            setTimeout(function () {
                                bsOffcanvas.hide();
                            }, 100);
                        }
                    });
                });

                // Limpeza estrita ao redimensionar para desktop (>= 992px)
                window.addEventListener('resize', function () {
                    if (window.innerWidth >= 992) {
                        bsOffcanvas.hide();
                        document.querySelectorAll('.offcanvas-backdrop').forEach(function (backdrop) {
                            backdrop.remove();
                        });
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>