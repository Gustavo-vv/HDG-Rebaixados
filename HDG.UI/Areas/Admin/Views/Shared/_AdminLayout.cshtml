<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão Garagem | HDG Rebaixados</title>

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/hdg-favicon-16x16.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/hdg-favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/hdg-favicon-192x192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/hdg-apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#060809" />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts: Bebas Neue, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <!-- Topbar do Painel Administrativo -->
    <header class="admin-topbar d-flex justify-content-between align-items-center">
        <!-- Lado Esquerdo: Hambúrguer (Mobile) + Logo + Badge -->
        <div class="d-flex align-items-center gap-2 gap-md-3">
            <!-- Botão Hambúrguer para Off-Canvas no Mobile -->
            <button class="admin-toggle-sidebar-btn d-lg-none" 
                    type="button" 
                    data-bs-toggle="offcanvas" 
                    data-bs-target="#adminOffcanvasSidebar" 
                    aria-controls="adminOffcanvasSidebar" 
                    aria-label="Abrir Menu de Navegação">
                <i class="bi bi-list"></i>
            </button>

            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="hdg-logo-link d-flex align-items-center">
                <img src="~/img/hdg-logo-header.png" 
                     alt="HDG Rebaixados" 
                     class="admin-logo-img"
                     loading="eager"
                     asp-append-version="true" />
            </a>
            <span class="admin-badge-top">GARAGEM ADMIN</span>
        </div>

        <!-- Lado Direito: Ver Catálogo Público + Menu de Perfil -->
        <div class="d-flex align-items-center gap-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" 
               class="btn btn-outline-dark-custom admin-btn-catalog" 
               target="_blank" 
               aria-label="Ver Catálogo Público"
               title="Ver Catálogo Público">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>Ver Catálogo</span>
            </a>

            <div class="dropdown">
                <button class="btn btn-profile-menu dropdown-toggle d-flex align-items-center justify-content-center" 
                        type="button" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false" 
                        aria-label="Menu de Perfil"
                        title="Menu de Perfil"
                        style="width: 40px; height: 40px;">
                    <i class="bi bi-person-fill-gear fs-5 text-warning"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow-lg p-2" style="min-width: 180px;">
                    <li>
                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger py-2 fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-box-arrow-right"></i> Encerrar Sessão
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Shell do Painel Administrativo (CSS Grid) -->
    <div class="admin-shell-grid">
        <!-- Sidebar Unificada: Offcanvas no Mobile/Tablet (< 992px) e Sticky Estático no Desktop (>= 992px via offcanvas-lg) -->
        <aside class="offcanvas-lg offcanvas-start admin-sidebar-desktop" tabindex="-1" id="adminOffcanvasSidebar" aria-labelledby="adminOffcanvasLabel">
            <div class="offcanvas-header d-lg-none border-bottom border-secondary border-opacity-25 pb-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 36px; width: auto;" asp-append-version="true" />
                    <span class="admin-badge-top">ADMIN</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminOffcanvasSidebar" aria-label="Fechar Menu"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column justify-content-between p-0">
                <div>
                    <div class="small text-uppercase text-secondary fw-bold px-3 mb-2" style="letter-spacing: 0.08em; font-size: 0.72rem;">
                        Menu de Gestão
                    </div>
                    <nav class="d-flex flex-column px-2 px-lg-0">
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" 
                           class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i> Visão Geral
                        </a>
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Pecas" 
                           class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Peca") == true ? "active" : "")">
                            <i class="bi bi-boxes"></i> Catálogo de Peças
                        </a>
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Avaliacoes" 
                           class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Avaliacoes" ? "active" : "")">
                            <i class="bi bi-chat-square-quote-fill"></i> Moderação
                        </a>
                        <a asp-area="Admin" asp-controller="Admin" asp-action="Usuarios" 
                           class="admin-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Usuarios" ? "active" : "")">
                            <i class="bi bi-people-fill"></i> Usuários
                        </a>
                    </nav>
                </div>

                <div class="pt-3 border-top border-secondary border-opacity-25 mt-4 px-2 px-lg-0">
                    <div class="small text-uppercase text-secondary fw-bold px-3 mb-2 d-none d-lg-block" style="letter-spacing: 0.08em; font-size: 0.72rem;">
                        Ações Rápidas
                    </div>
                    <a asp-area="Admin" asp-controller="Admin" asp-action="PecaNova" class="btn btn-racing w-100 justify-content-center">
                        <i class="bi bi-plus-lg me-1"></i> Cadastrar Peça
                    </a>
                </div>
            </div>
        </aside>

        <!-- Conteúdo Principal da Página Admin -->
        <main class="admin-main-content">
            <div class="admin-content-container">
                <!-- Alertas e Mensagens -->
                @if (TempData["MensagemSucesso"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border border-success text-white mb-4" role="alert">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> @TempData["MensagemSucesso"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
                    </div>
                }
                @if (TempData["MensagemErro"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-25 border border-danger text-white mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> @TempData["MensagemErro"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Bootstrap Bundle JS & Custom Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Fechamento automático do menu offcanvas no mobile e limpeza de backdrop ao redimensionar
        document.addEventListener('DOMContentLoaded', function () {
            var offcanvasEl = document.getElementById('adminOffcanvasSidebar');
            if (offcanvasEl && typeof bootstrap !== 'undefined') {
                var bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                var navLinks = offcanvasEl.querySelectorAll('.admin-nav-item, .offcanvas-body a.btn');
                navLinks.forEach(function (link) {
                    link.addEventListener('click', function () {
                        // Fecha no mobile se estiver em modo offcanvas
                        if (window.innerWidth < 992) {
                            setTimeout(function () {
                                bsOffcanvas.hide();
                            }, 150);
                        }
                    });
                });

                // Limpa backdrops presos e restaura scroll do body ao redimensionar de mobile para desktop
                window.addEventListener('resize', function () {
                    if (window.innerWidth >= 992) {
                        bsOffcanvas.hide();
                        document.querySelectorAll('.offcanvas-backdrop').forEach(function (backdrop) {
                            backdrop.remove();
                        });
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>