@{
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();
    var isMobile = ViewData["IsMobileMenu"] as bool? ?? false;
}

<div class="offcanvas-header @(isMobile ? "d-flex" : "d-lg-none") border-bottom border-secondary border-opacity-25 pb-3 mb-3">
    <div class="d-flex align-items-center gap-2">
        <img src="~/img/hdg-logo-header.png" alt="HDG Rebaixados" style="height: 36px; width: auto;" asp-append-version="true" />
        <span class="admin-badge-top">ADMIN</span>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar Menu"></button>
</div>

<div class="offcanvas-body d-flex flex-column justify-content-between p-0">
    <div>
        <div class="small text-uppercase text-secondary fw-bold px-3 mb-2" style="letter-spacing: 0.08em; font-size: 0.72rem;">
            Menu de Gestão
        </div>
        <nav class="d-flex flex-column px-2 px-lg-0">
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" 
               class="admin-nav-item @(actionAtual == "Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Visão Geral
            </a>
            <a asp-area="Admin" asp-controller="Admin" asp-action="Pecas" 
               class="admin-nav-item @(actionAtual?.StartsWith("Peca") == true && actionAtual != "PecaNova" ? "active" : "")">
                <i class="bi bi-boxes"></i> Gestão de Peças
            </a>
            <a asp-area="Admin" asp-controller="Admin" asp-action="Avaliacoes" 
               class="admin-nav-item d-flex justify-content-between align-items-center @(actionAtual == "Avaliacoes" ? "active" : "")">
                <span><i class="bi bi-chat-square-quote-fill me-2"></i> Moderação</span>
                @if ((ViewBag.AvaliacoesPendentesBadge ?? 0) > 0)
                {
                    <span class="badge rounded-pill bg-warning text-dark font-display px-2 py-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        @ViewBag.AvaliacoesPendentesBadge
                    </span>
                }
            </a>
            <a asp-area="Admin" asp-controller="Admin" asp-action="Usuarios" 
               class="admin-nav-item @(actionAtual == "Usuarios" ? "active" : "")">
                <i class="bi bi-people-fill"></i> Usuários
            </a>
        </nav>
    </div>

    <div class="pt-3 border-top border-secondary border-opacity-25 mt-4 px-2 px-lg-0 pb-3 pb-lg-0">
        <div class="small text-uppercase text-secondary fw-bold px-3 mb-2" style="letter-spacing: 0.08em; font-size: 0.72rem;">
            Ações Rápidas
        </div>
        <div class="d-flex flex-column gap-2">
            <a asp-area="Admin" asp-controller="Admin" asp-action="PecaNova" class="btn btn-racing w-100 justify-content-center">
                <i class="bi bi-plus-lg me-1"></i> Cadastrar Peça
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark-custom w-100 justify-content-center admin-nav-catalog-btn">
                <i class="bi bi-box-arrow-up-right me-1 text-accent"></i> Ver Catálogo
            </a>
        </div>
    </div>
</div>
