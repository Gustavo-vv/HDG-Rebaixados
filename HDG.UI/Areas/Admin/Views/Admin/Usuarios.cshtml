@model IEnumerable<HDG.Domain.Entidades.ApplicationUser>
@{
    ViewData["Title"] = "Gestão de Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold text-white mb-1 font-heading">Gestão de Usuários</h1>
        <p class="text-secondary small mb-0">Controle de acessos, administradores e clientes cadastrados.</p>
    </div>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table-dark-custom">
            <thead>
                <tr>
                    <th>Nome Completo</th>
                    <th>E-mail</th>
                    <th>Data de Cadastro</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="text-white fw-bold">
                            <i class="bi bi-person-circle text-secondary me-2"></i> @user.NomeCompleto
                        </td>
                        <td class="text-secondary font-monospace">@user.Email</td>
                        <td class="text-secondary small">@user.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (user.Ativo)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                    <i class="bi bi-check-circle"></i> Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                    <i class="bi bi-x-circle"></i> Inativo
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>