@model IReadOnlyList<HDG.Application.DTOs.UsuarioListaDto>
@{
    ViewData["Title"] = "Gestão de Usuários";
    var filtro = ViewBag.Filtro as HDG.Application.DTOs.FiltroUsuariosDto ?? new HDG.Application.DTOs.FiltroUsuariosDto();
    var adminLogadoId = ViewBag.AdminLogadoId as string ?? string.Empty;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-bold text-white mb-1 font-heading">Gestão de Usuários</h1>
        <p class="text-secondary small mb-0">Controle de acessos, administradores, senhas e clientes cadastrados.</p>
    </div>
    <div>
        <span class="badge bg-dark border border-secondary text-light px-3 py-2 fs-6">
            <i class="bi bi-people-fill text-accent-green me-2"></i>
            <span id="usuariosContador">@Model.Count</span> @(Model.Count == 1 ? "usuário encontrado" : "usuários encontrados")
        </span>
    </div>
</div>

<!-- Filtros e Barra de Busca -->
<div class="glass-panel p-3 mb-4">
    <form method="get" asp-action="Usuarios" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="Busca" value="@filtro.Busca" class="form-control form-control-custom" placeholder="Buscar por nome, e-mail ou telefone..." aria-label="Buscar usuários" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="Status" class="form-select form-control-custom">
                <option value="todos" selected="@(filtro.Status == null || filtro.Status == "todos")">Todos os Status</option>
                <option value="ativos" selected="@(filtro.Status == "ativos")">Somente Ativos</option>
                <option value="inativos" selected="@(filtro.Status == "inativos")">Somente Inativos</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="Role" class="form-select form-control-custom">
                <option value="todos" selected="@(filtro.Role == null || filtro.Role == "todos")">Todos os Perfis</option>
                <option value="Admin" selected="@(filtro.Role == "Admin")">Admin</option>
                <option value="Cliente" selected="@(filtro.Role == "Cliente")">Cliente</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-racing w-100 justify-content-center">
                <i class="bi bi-funnel-fill me-1"></i> Filtrar
            </button>
            @if (!string.IsNullOrWhiteSpace(filtro.Busca) || (!string.IsNullOrWhiteSpace(filtro.Status) && filtro.Status != "todos") || (!string.IsNullOrWhiteSpace(filtro.Role) && filtro.Role != "todos"))
            {
                <a asp-action="Usuarios" class="btn btn-outline-secondary" title="Limpar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Listagem de Usuários -->
<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table-dark-custom table-users-responsive align-middle">
            <thead>
                <tr>
                    <th style="min-width: 200px;">Nome Completo</th>
                    <th style="min-width: 220px;">E-mail</th>
                    <th style="min-width: 140px;">Telefone</th>
                    <th style="min-width: 110px;">Perfil</th>
                    <th style="min-width: 140px;">Cadastro (Brasília)</th>
                    <th style="min-width: 100px;">Status</th>
                    <th style="min-width: 160px;" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-person-x fs-1 d-block mb-2 opacity-50"></i>
                            Nenhum usuário encontrado com os filtros selecionados.
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    var isProprioUsuario = user.Id == adminLogadoId;
                    <tr>
                        <td data-label="Nome Completo" class="text-white fw-bold">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 34px; height: 34px; background: rgba(255,255,255,0.08); font-size: 0.85rem; font-weight: 700; flex-shrink: 0;">
                                    @(string.IsNullOrWhiteSpace(user.NomeCompleto) ? "U" : user.NomeCompleto[0].ToString().ToUpper())
                                </div>
                                <div>
                                    <span>@user.NomeCompleto</span>
                                    @if (isProprioUsuario)
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size: 0.68rem;">Você</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td data-label="E-mail" class="text-secondary font-monospace small">
                            @user.Email
                        </td>
                        <td data-label="Telefone" class="text-secondary small">
                            @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)
                        </td>
                        <td data-label="Perfil">
                            @if (user.IsAdmin)
                            {
                                <span class="badge-role-admin rounded-pill">
                                    <i class="bi bi-shield-shaded"></i> Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge-role-cliente rounded-pill">
                                    <i class="bi bi-person"></i> Cliente
                                </span>
                            }
                        </td>
                        <td data-label="Cadastro" class="text-secondary small">
                            @user.DataCadastroBrasilia.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-label="Status">
                            @if (user.Ativo)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                    <i class="bi bi-check-circle"></i> Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                    <i class="bi bi-x-circle"></i> Inativo
                                </span>
                            }
                        </td>
                        <td data-label="Ações" class="text-end">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Ações do Usuário">
                                <!-- Botão Editar -->
                                <button type="button" 
                                        class="btn btn-outline-secondary" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalEditarUsuario"
                                        data-user-id="@user.Id"
                                        data-user-nome="@user.NomeCompleto"
                                        data-user-email="@user.Email"
                                        data-user-telefone="@user.PhoneNumber"
                                        title="Editar Dados"
                                        aria-label="Editar @user.NomeCompleto">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <!-- Botão Alterar Senha -->
                                <button type="button" 
                                        class="btn btn-outline-warning" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalAlterarSenha"
                                        data-user-id="@user.Id"
                                        data-user-nome="@user.NomeCompleto"
                                        title="Redefinir Senha"
                                        aria-label="Redefinir senha de @user.NomeCompleto">
                                    <i class="bi bi-key-fill"></i>
                                </button>

                                <!-- Botão Alterar Perfil -->
                                <button type="button" 
                                        class="btn btn-outline-info" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalAlterarPerfil"
                                        data-user-id="@user.Id"
                                        data-user-nome="@user.NomeCompleto"
                                        data-user-role="@(user.IsAdmin ? "Admin" : "Cliente")"
                                        data-is-self="@(isProprioUsuario ? "true" : "false")"
                                        title="Alterar Perfil"
                                        aria-label="Alterar perfil de @user.NomeCompleto">
                                    <i class="bi bi-person-gear"></i>
                                </button>

                                <!-- Botão Alternar Status (Ativar / Desativar) -->
                                @if (user.Ativo)
                                {
                                    <button type="button" 
                                            class="btn btn-outline-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalAlternarStatus"
                                            data-user-id="@user.Id"
                                            data-user-nome="@user.NomeCompleto"
                                            data-action-type="desativar"
                                            data-is-self="@(isProprioUsuario ? "true" : "false")"
                                            title="Desativar Usuário"
                                            aria-label="Desativar @user.NomeCompleto">
                                        <i class="bi bi-person-x-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" 
                                            class="btn btn-outline-success" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalAlternarStatus"
                                            data-user-id="@user.Id"
                                            data-user-nome="@user.NomeCompleto"
                                            data-action-type="ativar"
                                            data-is-self="false"
                                            title="Ativar Usuário"
                                            aria-label="Ativar @user.NomeCompleto">
                                        <i class="bi bi-person-check-fill"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: EDITAR USUÁRIO -->
<!-- ======================================================== -->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-labelledby="modalEditarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content glass-panel border border-secondary border-opacity-50 text-white" style="background: rgba(14, 18, 20, 0.96);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold" id="modalEditarUsuarioLabel">
                    <i class="bi bi-pencil-square text-accent-green me-2"></i>Editar Usuário
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" asp-action="UsuarioEditar" id="formEditarUsuario">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editarUserId" />
                <div class="modal-body">
                    <!-- E-mail Somente Leitura com Cadeado -->
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">E-mail de Acesso</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-lock-fill text-warning"></i>
                            </span>
                            <input type="email" id="editarUserEmail" class="form-control form-control-custom bg-dark text-secondary opacity-75 font-monospace" disabled readonly />
                        </div>
                        <div class="form-text text-secondary small">
                            <i class="bi bi-info-circle me-1"></i>O e-mail não pode ser alterado.
                        </div>
                    </div>

                    <!-- Nome Completo -->
                    <div class="mb-3">
                        <label for="editarUserNome" class="form-label text-light small fw-bold">Nome Completo *</label>
                        <input type="text" name="NomeCompleto" id="editarUserNome" class="form-control form-control-custom" required minlength="3" maxlength="100" />
                    </div>

                    <!-- Telefone com Máscara -->
                    <div class="mb-3">
                        <label for="editarUserTelefone" class="form-label text-light small fw-bold">Telefone / WhatsApp</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-telephone-fill"></i>
                            </span>
                            <input type="tel" name="Telefone" id="editarUserTelefone" class="form-control form-control-custom" placeholder="(11) 99999-9999" maxlength="15" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-racing btn-submit-loading">
                        <span class="btn-text"><i class="bi bi-check2 me-1"></i>Salvar Alterações</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: ALTERAR SENHA -->
<!-- ======================================================== -->
<div class="modal fade" id="modalAlterarSenha" tabindex="-1" aria-labelledby="modalAlterarSenhaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content glass-panel border border-secondary border-opacity-50 text-white" style="background: rgba(14, 18, 20, 0.96);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold" id="modalAlterarSenhaLabel">
                    <i class="bi bi-key-fill text-warning me-2"></i>Redefinir Senha
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" asp-action="UsuarioAlterarSenha" id="formAlterarSenha">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="senhaUserId" />
                <div class="modal-body">
                    <div class="alert alert-dark border border-secondary border-opacity-25 py-2 px-3 small text-secondary mb-3">
                        Definindo nova senha para: <strong class="text-white" id="senhaUserNome"></strong>
                    </div>

                    <!-- Botão Gerar Senha Forte -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label for="novaSenhaInput" class="form-label text-light small fw-bold mb-0">Nova Senha *</label>
                        <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 small" id="btnGerarSenhaForte" style="font-size: 0.75rem;">
                            <i class="bi bi-magic me-1"></i>Gerar senha forte
                        </button>
                    </div>

                    <!-- Campo Nova Senha -->
                    <div class="input-group mb-1">
                        <input type="password" name="NovaSenha" id="novaSenhaInput" class="form-control form-control-custom" required minlength="8" autocomplete="new-password" />
                        <button class="btn btn-outline-secondary btn-toggle-pwd" type="button" data-target="novaSenhaInput" title="Mostrar/Ocultar Senha">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Indicador de Força -->
                    <div class="password-strength-bar mb-3">
                        <div class="password-strength-progress" id="strengthProgress"></div>
                    </div>

                    <!-- Checklist de Requisitos -->
                    <div class="glass-panel p-2 mb-3 bg-dark bg-opacity-50">
                        <div class="row g-1">
                            <div class="col-6">
                                <div class="pwd-rule-item" id="ruleLength"><i class="bi bi-circle"></i> 8+ caracteres</div>
                            </div>
                            <div class="col-6">
                                <div class="pwd-rule-item" id="ruleUpper"><i class="bi bi-circle"></i> Letra maiúscula</div>
                            </div>
                            <div class="col-6">
                                <div class="pwd-rule-item" id="ruleLower"><i class="bi bi-circle"></i> Letra minúscula</div>
                            </div>
                            <div class="col-6">
                                <div class="pwd-rule-item" id="ruleNumber"><i class="bi bi-circle"></i> Número</div>
                            </div>
                            <div class="col-12">
                                <div class="pwd-rule-item" id="ruleSpecial"><i class="bi bi-circle"></i> Símbolo especial (!@@#$%&*)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirmar Senha -->
                    <div class="mb-3">
                        <label for="confirmarSenhaInput" class="form-label text-light small fw-bold">Confirmar Nova Senha *</label>
                        <div class="input-group">
                            <input type="password" name="ConfirmarSenha" id="confirmarSenhaInput" class="form-control form-control-custom" required minlength="8" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary btn-toggle-pwd" type="button" data-target="confirmarSenhaInput" title="Mostrar/Ocultar Senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="text-danger small mt-1 d-none" id="senhaMismatch">As senhas não conferem.</div>
                    </div>

                    <!-- Aviso de Invalidação de Sessão -->
                    <div class="small text-secondary">
                        <i class="bi bi-shield-lock me-1"></i>O carimbo de segurança (SecurityStamp) será atualizado e qualquer sessão aberta desse usuário será encerrada.
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning btn-submit-loading" id="btnSalvarSenha">
                        <span class="btn-text"><i class="bi bi-key-fill me-1"></i>Redefinir Senha</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: ALTERAR PERFIL (ROLE) -->
<!-- ======================================================== -->
<div class="modal fade" id="modalAlterarPerfil" tabindex="-1" aria-labelledby="modalAlterarPerfilLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content glass-panel border border-secondary border-opacity-50 text-white" style="background: rgba(14, 18, 20, 0.96);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold" id="modalAlterarPerfilLabel">
                    <i class="bi bi-person-gear text-info me-2"></i>Alterar Perfil de Acesso
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" asp-action="UsuarioAlterarPerfil" id="formAlterarPerfil">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="perfilUserId" />
                <div class="modal-body">
                    <p class="text-secondary small mb-3">
                        Selecione o nível de permissão para o usuário <strong class="text-white" id="perfilUserNome"></strong>:
                    </p>

                    <div id="perfilSelfWarning" class="alert alert-danger py-2 px-3 small d-none mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Atenção: Você não pode alterar ou revogar seu próprio perfil de administrador!
                    </div>

                    <div class="mb-3">
                        <div class="form-check p-3 rounded mb-2 border border-secondary border-opacity-25 bg-dark">
                            <input class="form-check-input" type="radio" name="NovaRole" id="roleAdmin" value="Admin">
                            <label class="form-check-label text-white fw-bold d-block" for="roleAdmin">
                                <i class="bi bi-shield-shaded text-warning me-1"></i> Administrador
                                <span class="d-block text-secondary fw-normal small">Acesso total ao painel administrativo, peças, moderação e usuários.</span>
                            </label>
                        </div>
                        <div class="form-check p-3 rounded border border-secondary border-opacity-25 bg-dark">
                            <input class="form-check-input" type="radio" name="NovaRole" id="roleCliente" value="Cliente">
                            <label class="form-check-label text-white fw-bold d-block" for="roleCliente">
                                <i class="bi bi-person text-secondary me-1"></i> Cliente
                                <span class="d-block text-secondary fw-normal small">Acesso apenas às áreas públicas do site e envio de avaliações.</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info btn-submit-loading" id="btnSalvarPerfil">
                        <span class="btn-text"><i class="bi bi-check2 me-1"></i>Confirmar Alteração</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: ALTERNAR STATUS (ATIVAR / DESATIVAR) -->
<!-- ======================================================== -->
<div class="modal fade" id="modalAlternarStatus" tabindex="-1" aria-labelledby="modalAlternarStatusLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content glass-panel border border-secondary border-opacity-50 text-white" style="background: rgba(14, 18, 20, 0.96);">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-heading fw-bold" id="modalAlternarStatusLabel">
                    <span id="statusModalIcon"></span> <span id="statusModalTitle">Confirmar Ação</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" asp-action="UsuarioAlternarStatus" id="formAlternarStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="statusUserId" />
                <div class="modal-body">
                    <div id="statusSelfWarning" class="alert alert-danger py-2 px-3 small d-none mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Atenção: Você não pode desativar seu próprio usuário de administrador!
                    </div>

                    <p class="text-white mb-2" id="statusModalMensagem"></p>
                    <p class="text-secondary small mb-0" id="statusModalDetalhe"></p>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-submit-loading" id="btnConfirmarStatus">
                        <span class="btn-text">Confirmar</span>
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ----------------------------------------------------
    // Máscara brasileira de telefone: (11) 99999-9999 ou (11) 9999-9999
    // ----------------------------------------------------
    function aplicarMascaraTelefone(input) {
        if (!input) return;
        input.addEventListener('input', function (e) {
            let v = e.target.value.replace(/\D/g, '');
            if (v.length > 11) v = v.substring(0, 11);

            if (v.length > 10) {
                // (XX) XXXXX-XXXX
                v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
            } else if (v.length > 6) {
                // (XX) XXXX-XXXX
                v = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
            } else if (v.length > 2) {
                v = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
            } else if (v.length > 0) {
                v = v.replace(/^(\d*)/, '($1');
            }
            e.target.value = v;
        });
    }

    const inputTelefone = document.getElementById('editarUserTelefone');
    aplicarMascaraTelefone(inputTelefone);

    // ----------------------------------------------------
    // Modal Editar Usuário
    // ----------------------------------------------------
    const modalEditar = document.getElementById('modalEditarUsuario');
    if (modalEditar) {
        modalEditar.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editarUserId').value = btn.getAttribute('data-user-id');
            document.getElementById('editarUserEmail').value = btn.getAttribute('data-user-email');
            document.getElementById('editarUserNome').value = btn.getAttribute('data-user-nome');
            document.getElementById('editarUserTelefone').value = btn.getAttribute('data-user-telefone') || '';
        });
    }

    // ----------------------------------------------------
    // Modal Alterar Senha & Validações
    // ----------------------------------------------------
    const modalSenha = document.getElementById('modalAlterarSenha');
    const inputNovaSenha = document.getElementById('novaSenhaInput');
    const inputConfirmarSenha = document.getElementById('confirmarSenhaInput');
    const strengthProgress = document.getElementById('strengthProgress');
    const ruleLength = document.getElementById('ruleLength');
    const ruleUpper = document.getElementById('ruleUpper');
    const ruleLower = document.getElementById('ruleLower');
    const ruleNumber = document.getElementById('ruleNumber');
    const ruleSpecial = document.getElementById('ruleSpecial');
    const senhaMismatch = document.getElementById('senhaMismatch');
    const btnSalvarSenha = document.getElementById('btnSalvarSenha');

    if (modalSenha) {
        modalSenha.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('senhaUserId').value = btn.getAttribute('data-user-id');
            document.getElementById('senhaUserNome').textContent = btn.getAttribute('data-user-nome');
            inputNovaSenha.value = '';
            inputConfirmarSenha.value = '';
            atualizarForcaSenha('');
        });
    }

    function atualizarForcaSenha(pwd) {
        const hasLength = pwd.length >= 8;
        const hasUpper = /[A-Z]/.test(pwd);
        const hasLower = /[a-z]/.test(pwd);
        const hasNumber = /[0-9]/.test(pwd);
        const hasSpecial = /[^A-Za-z0-9]/.test(pwd);

        atualizarRegraUI(ruleLength, hasLength);
        atualizarRegraUI(ruleUpper, hasUpper);
        atualizarRegraUI(ruleLower, hasLower);
        atualizarRegraUI(ruleNumber, hasNumber);
        atualizarRegraUI(ruleSpecial, hasSpecial);

        let score = 0;
        if (hasLength) score += 20;
        if (hasUpper) score += 20;
        if (hasLower) score += 20;
        if (hasNumber) score += 20;
        if (hasSpecial) score += 20;

        strengthProgress.style.width = score + '%';
        if (score <= 40) {
            strengthProgress.style.backgroundColor = '#ef4444'; // Fraca
        } else if (score <= 80) {
            strengthProgress.style.backgroundColor = '#f59e0b'; // Média
        } else {
            strengthProgress.style.backgroundColor = '#10b981'; // Forte
        }

        verificarSenhasConferem();
    }

    function atualizarRegraUI(elem, valido) {
        if (!elem) return;
        if (valido) {
            elem.classList.add('rule-valid');
        } else {
            elem.classList.remove('rule-valid');
        }
    }

    function verificarSenhasConferem() {
        const s1 = inputNovaSenha.value;
        const s2 = inputConfirmarSenha.value;
        if (s2.length > 0 && s1 !== s2) {
            senhaMismatch.classList.remove('d-none');
            btnSalvarSenha.disabled = true;
        } else {
            senhaMismatch.classList.add('d-none');
            btnSalvarSenha.disabled = false;
        }
    }

    inputNovaSenha?.addEventListener('input', function () {
        atualizarForcaSenha(this.value);
    });

    inputConfirmarSenha?.addEventListener('input', function () {
        verificarSenhasConferem();
    });

    // Mostrar/Ocultar Senha
    document.querySelectorAll('.btn-toggle-pwd').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const targetId = this.getAttribute('data-target');
            const target = document.getElementById(targetId);
            if (!target) return;
            const icon = this.querySelector('i');
            if (target.type === 'password') {
                target.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                target.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    });

    // Gerador de Senha Forte no cliente (crypto.getRandomValues)
    document.getElementById('btnGerarSenhaForte')?.addEventListener('click', function () {
        const charsUpper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const charsLower = "abcdefghijkmnpqrstuvwxyz";
        const charsNumbers = "23456789";
        const charsSpecial = "!@@#$%&*";
        const allChars = charsUpper + charsLower + charsNumbers + charsSpecial;

        // Garante ao menos 1 de cada
        let pwd = [
            charsUpper[obterByteRandom() % charsUpper.length],
            charsLower[obterByteRandom() % charsLower.length],
            charsNumbers[obterByteRandom() % charsNumbers.length],
            charsSpecial[obterByteRandom() % charsSpecial.length]
        ];

        // Completa até 14 caracteres aleatórios
        for (let i = 0; i < 10; i++) {
            pwd.push(allChars[obterByteRandom() % allChars.length]);
        }

        // Embaralha com Fisher-Yates
        for (let i = pwd.length - 1; i > 0; i--) {
            const j = obterByteRandom() % (i + 1);
            [pwd[i], pwd[j]] = [pwd[j], pwd[i]];
        }

        const senhaFinal = pwd.join('');
        inputNovaSenha.value = senhaFinal;
        inputConfirmarSenha.value = senhaFinal;
        inputNovaSenha.type = 'text';
        inputConfirmarSenha.type = 'text';

        // Atualiza ícones dos botões de visualização
        document.querySelectorAll('.btn-toggle-pwd i').forEach(ic => ic.className = 'bi bi-eye-slash');

        atualizarForcaSenha(senhaFinal);

        // Copia para área de transferência se suportado
        if (navigator.clipboard) {
            navigator.clipboard.writeText(senhaFinal).then(function () {
                const btn = document.getElementById('btnGerarSenhaForte');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-clipboard-check me-1"></i>Copiada!';
                setTimeout(() => btn.innerHTML = originalHtml, 2000);
            });
        }
    });

    function obterByteRandom() {
        const arr = new Uint8Array(1);
        window.crypto.getRandomValues(arr);
        return arr[0];
    }

    // ----------------------------------------------------
    // Modal Alterar Perfil (Role)
    // ----------------------------------------------------
    const modalPerfil = document.getElementById('modalAlterarPerfil');
    if (modalPerfil) {
        modalPerfil.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            const userId = btn.getAttribute('data-user-id');
            const userName = btn.getAttribute('data-user-nome');
            const userRole = btn.getAttribute('data-user-role');
            const isSelf = btn.getAttribute('data-is-self') === 'true';

            document.getElementById('perfilUserId').value = userId;
            document.getElementById('perfilUserNome').textContent = userName;

            const radioAdmin = document.getElementById('roleAdmin');
            const radioCliente = document.getElementById('roleCliente');
            const btnSalvar = document.getElementById('btnSalvarPerfil');
            const warningSelf = document.getElementById('perfilSelfWarning');

            if (userRole === 'Admin') {
                radioAdmin.checked = true;
            } else {
                radioCliente.checked = true;
            }

            if (isSelf) {
                radioCliente.disabled = true;
                warningSelf.classList.remove('d-none');
                btnSalvar.disabled = true;
            } else {
                radioCliente.disabled = false;
                warningSelf.classList.add('d-none');
                btnSalvar.disabled = false;
            }
        });
    }

    // ----------------------------------------------------
    // Modal Alternar Status (Ativar / Desativar)
    // ----------------------------------------------------
    const modalStatus = document.getElementById('modalAlternarStatus');
    if (modalStatus) {
        modalStatus.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            const userId = btn.getAttribute('data-user-id');
            const userName = btn.getAttribute('data-user-nome');
            const actionType = btn.getAttribute('data-action-type');
            const isSelf = btn.getAttribute('data-is-self') === 'true';

            document.getElementById('statusUserId').value = userId;
            const btnConfirmar = document.getElementById('btnConfirmarStatus');
            const selfWarning = document.getElementById('statusSelfWarning');
            const modalTitle = document.getElementById('statusModalTitle');
            const modalIcon = document.getElementById('statusModalIcon');
            const modalMsg = document.getElementById('statusModalMensagem');
            const modalDet = document.getElementById('statusModalDetalhe');

            if (actionType === 'desativar') {
                modalTitle.textContent = 'Desativar Usuário';
                modalIcon.innerHTML = '<i class="bi bi-person-x-fill text-danger me-2"></i>';
                modalMsg.innerHTML = `Deseja realmente desativar <strong>${userName}</strong>?`;
                modalDet.textContent = 'Ele não poderá mais entrar no site e quaisquer sessões atualmente ativas serão imediatamente encerradas.';
                btnConfirmar.className = 'btn btn-danger btn-submit-loading';
                btnConfirmar.querySelector('.btn-text').textContent = 'Sim, Desativar';
            } else {
                modalTitle.textContent = 'Reativar Usuário';
                modalIcon.innerHTML = '<i class="bi bi-person-check-fill text-success me-2"></i>';
                modalMsg.innerHTML = `Deseja reativar o acesso de <strong>${userName}</strong>?`;
                modalDet.textContent = 'O usuário poderá fazer login normalmente após a ativação.';
                btnConfirmar.className = 'btn btn-success btn-submit-loading';
                btnConfirmar.querySelector('.btn-text').textContent = 'Sim, Reativar';
            }

            if (isSelf && actionType === 'desativar') {
                selfWarning.classList.remove('d-none');
                btnConfirmar.disabled = true;
            } else {
                selfWarning.classList.add('d-none');
                btnConfirmar.disabled = false;
            }
        });
    }

    // ----------------------------------------------------
    // Estado de Loading nos Botões ao Submeter Formulários
    // ----------------------------------------------------
    document.querySelectorAll('form').forEach(function (f) {
        f.addEventListener('submit', function () {
            const btn = this.querySelector('.btn-submit-loading');
            if (btn && !btn.disabled) {
                const spinner = btn.querySelector('.spinner-border');
                if (spinner) spinner.classList.remove('d-none');
                btn.disabled = true;
            }
        });
    });
});
</script>
}