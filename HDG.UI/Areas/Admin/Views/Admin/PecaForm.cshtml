@model HDG.Application.DTOs.CriarPecaDto
@{
    ViewData["Title"] = "Nova Peça";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold text-white mb-1 font-heading">Cadastrar Nova Peça</h1>
        <p class="text-secondary small mb-0">Adicione um novo item preparado ao catálogo oficial da HDG Rebaixados.</p>
    </div>
    <a asp-action="Pecas" class="btn btn-outline-dark-custom">
        <i class="bi bi-arrow-left me-1"></i> Voltar para Lista
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="glass-panel p-4 p-md-5">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border border-danger text-white small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="PecaNova" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label-custom">Nome do Produto *</label>
                        <input asp-for="Nome" class="form-control form-control-custom" placeholder="Ex: Kit Suspensão a Ar Tebão I-System 8mm" required autofocus />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label-custom">Categoria *</label>
                        <select asp-for="Categoria" class="form-select form-select-custom" required>
                            <option value="1">Suspensão</option>
                            <option value="2">Rodas</option>
                            <option value="3">Freios</option>
                            <option value="4">Motor & Performance</option>
                            <option value="5">Escapamento</option>
                            <option value="6">Interior</option>
                            <option value="7">Acessórios</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Preço de Venda (R$) *</label>
                        <input asp-for="Preco" type="number" step="0.01" class="form-control form-control-custom" placeholder="Ex: 4890.00" required />
                        <span asp-validation-for="Preco" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="Ativo" class="form-check-input" type="checkbox" id="switchAtivo" checked />
                            <label class="form-check-label text-white fw-bold ms-2" for="switchAtivo">
                                Produto Ativo no Catálogo
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom">Descrição Detalhada & Ficha Técnica *</label>
                    <textarea asp-for="Descricao" rows="5" class="form-control form-control-custom" 
                              placeholder="Descreva as especificações, compatibilidade de modelos de carros, espessuras de mangueiras, furações de roda, etc." required></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label-custom">Upload de Foto (Cloudinary)</label>
                        <input type="file" name="imagemArquivo" class="form-control form-control-custom" accept="image/*" />
                        <small class="text-muted">Formatos: JPG, PNG, WEBP até 10MB</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Ou URL Direta de Imagem</label>
                        <input type="url" name="imagemUrlManual" class="form-control form-control-custom" placeholder="https://exemplo.com/foto.jpg" />
                        <small class="text-muted">Cole uma URL externa caso não queira fazer upload</small>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-racing btn-lg">
                        <i class="bi bi-check2-circle me-1"></i> Publicar Peça no Catálogo
                    </button>
                    <a asp-action="Pecas" class="btn btn-outline-dark-custom btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="glass-panel p-4">
            <h5 class="text-white fw-bold mb-3 font-heading">
                <i class="bi bi-lightbulb-fill text-warning me-2"></i> Dicas para Vender Mais
            </h5>
            <ul class="text-secondary small ps-3 mb-0" style="line-height: 1.8;">
                <li class="mb-2"><strong>Título claro:</strong> Especifique a marca do kit (ex: Tebão, Castor) e diâmetro de válvulas (ex: 8mm, 10mm).</li>
                <li class="mb-2"><strong>Rodas:</strong> Sempre informe aro, tala e furação (ex: Aro 18 Tala 8.5 4x100).</li>
                <li class="mb-2"><strong>Fotos de alta resolução:</strong> Fotos nítidas aumentam em mais de 70% as conversões via WhatsApp.</li>
            </ul>
        </div>
    </div>
</div>
