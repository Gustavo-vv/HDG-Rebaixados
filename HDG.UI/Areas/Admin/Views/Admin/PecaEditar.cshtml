@model HDG.Application.DTOs.AtualizarPecaDto
@{
    ViewData["Title"] = "Editar Peça";
    var pecaExistente = ViewBag.PecaExistente as HDG.Application.DTOs.PecaDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold text-white mb-1 font-heading">Editar Peça #@Model.Id.ToString("D4")</h1>
        <p class="text-secondary small mb-0">Atualize informações, preços ou fotos deste item do catálogo.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="" asp-controller="Home" asp-action="Detalhes" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-dark-custom">
            <i class="bi bi-eye me-1"></i> Ver na Loja
        </a>
        <a asp-action="Pecas" class="btn btn-sm btn-outline-dark-custom">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="glass-panel p-4 p-md-5">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border border-danger text-white small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="PecaEditar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label-custom">Nome do Produto *</label>
                        <input asp-for="Nome" class="form-control form-control-custom" required />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label-custom">Categoria *</label>
                        <select asp-for="Categoria" class="form-select form-select-custom" required>
                            <option value="1">Suspensão</option>
                            <option value="2">Rodas</option>
                            <option value="3">Freios</option>
                            <option value="4">Motor & Performance</option>
                            <option value="5">Escapamento</option>
                            <option value="6">Interior</option>
                            <option value="7">Acessórios</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Preço de Venda (R$) *</label>
                        <input asp-for="Preco" type="number" step="0.01" class="form-control form-control-custom" required />
                        <span asp-validation-for="Preco" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="Ativo" class="form-check-input" type="checkbox" id="switchAtivo" />
                            <label class="form-check-label text-white fw-bold ms-2" for="switchAtivo">
                                Produto Ativo no Catálogo
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom">Descrição Detalhada *</label>
                    <textarea asp-for="Descricao" rows="5" class="form-control form-control-custom" required></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <!-- Existing Images with Delete and Set as Main Option -->
                @if (pecaExistente?.Imagens.Any() == true)
                {
                    <div class="mb-4">
                        <label class="form-label-custom">Imagens Atuais Cadastradas</label>
                        <div class="d-flex flex-wrap gap-3 p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-light);">
                            @foreach (var img in pecaExistente.Imagens)
                            {
                                <div class="position-relative rounded-3 border @(img.Principal ? "border-success border-2 shadow-sm" : "border-secondary border-opacity-50") overflow-hidden" style="width: 130px; height: 130px; background: #000;">
                                    <img src="@img.Url" alt="Foto da Peça" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=400&q=80'" />
                                    
                                    @if (img.Principal)
                                    {
                                        <span class="badge position-absolute top-0 start-0 m-1" style="background: var(--accent-green); color: #000; font-weight: 800; font-size: 0.65rem;">
                                            <i class="bi bi-star-fill"></i> Principal
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="submit" 
                                                formaction="@Url.Action("DefinirPrincipal", new { pecaId = Model.Id, imagemId = img.Id })" 
                                                class="btn btn-sm position-absolute top-0 start-0 m-1 p-1 px-2 text-white" 
                                                style="background: rgba(0,0,0,0.7); font-size: 0.65rem; border-radius: 4px;"
                                                title="Tornar esta a imagem principal">
                                            <i class="bi bi-star"></i> Tornar Principal
                                        </button>
                                    }

                                    <button type="submit" 
                                            formaction="@Url.Action("RemoverFoto", new { pecaId = Model.Id, imagemId = img.Id })" 
                                            class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-1 px-2" 
                                            style="font-size: 0.65rem; border-radius: 4px;"
                                            onclick="return confirm('Deseja realmente remover esta foto?');"
                                            title="Remover foto">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label-custom">Adicionar Nova Foto (Upload Cloudinary)</label>
                        <input type="file" name="novaImagemArquivo" class="form-control form-control-custom" accept="image/*" />
                        <small class="text-secondary" style="font-size: 0.78rem;">Upload direto com otimização no Cloudinary</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Ou Nova URL de Imagem</label>
                        <input type="url" name="novaImagemUrlManual" class="form-control form-control-custom" placeholder="https://res.cloudinary.com/... ou https://..." />
                        <small class="text-secondary" style="font-size: 0.78rem;">Cole link direto de imagem na web</small>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-racing">
                        <i class="bi bi-save me-1"></i> Salvar Alterações
                    </button>
                    <a asp-action="Pecas" class="btn btn-outline-dark-custom">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>