@{
    ViewData["Title"] = "Visão Geral do Painel";
    var totalPecas = ViewBag.TotalPecas ?? 0;
    var pecasAtivas = ViewBag.PecasAtivas ?? 0;
    var pecasInativas = ViewBag.PecasInativas ?? 0;
    var avaliacoesPendentes = ViewBag.AvaliacoesPendentes ?? 0;
    var valorEstoque = (decimal)(ViewBag.ValorTotalEstoque ?? 0m);
    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;

    var ultimasPecas = ViewBag.UltimasPecas as IEnumerable<HDG.Application.DTOs.PecaDto> ?? Enumerable.Empty<HDG.Application.DTOs.PecaDto>();
    var avaliacoesPendentesLista = ViewBag.UltimasAvaliacoesPendentes as IEnumerable<HDG.Application.DTOs.AvaliacaoDto> ?? Enumerable.Empty<HDG.Application.DTOs.AvaliacaoDto>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-bold text-white mb-1 font-heading">Painel de Controle</h1>
        <p class="text-secondary small mb-0">Gestão integrada do catálogo automotivo, moderação e estoque.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PecaNova" class="btn btn-racing">
            <i class="bi bi-plus-lg me-1"></i> Nova Peça
        </a>
        <a asp-action="Avaliacoes" class="btn btn-outline-dark-custom position-relative">
            <i class="bi bi-chat-dots-fill me-1"></i> Moderação
            @if (avaliacoesPendentes > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @avaliacoesPendentes
                </span>
            }
        </a>
    </div>
</div>

<!-- KPI Cards Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 g-md-4 mb-4 mb-md-5">
    <div class="col">
        <div class="stat-kpi-card">
            <div class="kpi-icon bg-danger bg-opacity-10 text-success">
                <i class="bi bi-boxes"></i>
            </div>
            <h3>@totalPecas</h3>
            <p>Total de Peças Cadastradas</p>
            <div class="small text-secondary mt-2">
                <span class="text-success"><i class="bi bi-check-circle"></i> @pecasAtivas ativas</span> | 
                <span class="text-secondary">@pecasInativas inativas</span>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="stat-kpi-card">
            <div class="kpi-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-chat-square-text-fill"></i>
            </div>
            <h3 class="@(avaliacoesPendentes > 0 ? "text-warning" : "text-white")">@avaliacoesPendentes</h3>
            <p>Avaliações Aguardando Moderação</p>
            <div class="small text-secondary mt-2">
                @(avaliacoesPendentes > 0 ? "Requer atenção do moderador" : "Todas as avaliações moderadas")
            </div>
        </div>
    </div>

    <div class="col">
        <div class="stat-kpi-card">
            <div class="kpi-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <h3><small class="fs-5 text-secondary">R$</small> @valorEstoque.ToString("N0")</h3>
            <p>Valor Total em Catálogo</p>
            <div class="small text-success mt-2">
                <i class="bi bi-graph-up"></i> Soma das peças ativas
            </div>
        </div>
    </div>

    <div class="col">
        <div class="stat-kpi-card">
            <div class="kpi-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-people-fill"></i>
            </div>
            <h3>@totalUsuarios</h3>
            <p>Contas de Usuários</p>
            <div class="small text-secondary mt-2">
                <i class="bi bi-shield-check text-info"></i> Admins & Clientes
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Parts -->
    <div class="col-lg-7">
        <div class="glass-panel p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white fw-bold mb-0 font-heading">
                    <i class="bi bi-box-seam text-success me-2"></i> Peças Recentes
                </h5>
                <a asp-action="Pecas" class="btn btn-outline-dark-custom btn-sm">Ver Todas</a>
            </div>

            @if (!ultimasPecas.Any())
            {
                <p class="text-secondary small">Nenhuma peça cadastrada.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-dark-custom table-admin-responsive">
                        <thead>
                            <tr>
                                <th>Peça</th>
                                <th>Categoria</th>
                                <th>Preço</th>
                                <th>Status</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var peca in ultimasPecas)
                            {
                                <tr>
                                    <td data-label="Peça">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(peca.ImagemPrincipalUrl ?? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=150&q=80")" 
                                                 alt="@peca.Nome" class="rounded admin-thumb-img" style="width: 44px; height: 44px; object-fit: cover;" />
                                            <div>
                                                <div class="text-white fw-bold text-truncate" style="max-width: 180px;">@peca.Nome</div>
                                                <span class="text-secondary small">#@peca.Id.ToString("D4")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Categoria">
                                        <span class="badge bg-dark border border-secondary text-secondary">@peca.Categoria</span>
                                    </td>
                                    <td data-label="Preço" class="text-white font-heading fw-bold">
                                        R$ @peca.Preco.ToString("N2")
                                    </td>
                                    <td data-label="Status">
                                        @if (peca.Ativo)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success">Ativa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary">Inativa</span>
                                        }
                                    </td>
                                    <td data-label="Ação" class="text-end">
                                        <a asp-action="PecaEditar" asp-route-id="@peca.Id" class="btn btn-sm btn-outline-dark-custom py-1 px-2" title="Editar" aria-label="Editar peça @peca.Nome">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Pending Reviews -->
    <div class="col-lg-5">
        <div class="glass-panel p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white fw-bold mb-0 font-heading">
                    <i class="bi bi-hourglass-split text-warning me-2"></i> Moderação Pendente
                </h5>
                <a asp-action="Avaliacoes" class="btn btn-outline-dark-custom btn-sm">Todas</a>
            </div>

            @if (!avaliacoesPendentesLista.Any())
            {
                <div class="text-center py-4 text-secondary small">
                    <i class="bi bi-check2-circle fs-2 text-success d-block mb-2"></i>
                    Nenhuma avaliação pendente de moderação no momento.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var av in avaliacoesPendentesLista)
                    {
                        <div class="p-3 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.02);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-white small">@av.NomeCliente</strong>
                                <div class="rating-stars small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= av.Nota)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-secondary"></i>
                                        }
                                    }
                                </div>
                            </div>
                            <p class="text-secondary small mb-2">@(string.IsNullOrWhiteSpace(av.Comentario) ? "Sem comentário de texto." : av.Comentario)</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Ref. Peça #@av.PecaId</span>
                                <form asp-action="AvaliacaoAprovar" asp-route-id="@av.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success py-1 px-3 fw-bold">
                                        <i class="bi bi-check2"></i> Aprovar
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
